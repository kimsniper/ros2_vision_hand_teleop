<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="controlled_joint" params="name initial_value:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="robot_control">
    <ros2_control name="robot_system" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="calculate_dynamics">false</param>
      </hardware>

      <xacro:controlled_joint name="A1" initial_value="-0.0118372929"/>
      <xacro:controlled_joint name="A2" initial_value="0.3619442767"/>
      <xacro:controlled_joint name="A3" initial_value="0.0203688758"/>
      <xacro:controlled_joint name="A4" initial_value="-0.8696515962"/>
      <xacro:controlled_joint name="A5" initial_value="-0.0000001706"/>
      <xacro:controlled_joint name="A6" initial_value="-0.4461612400"/>
      <xacro:controlled_joint name="A7" initial_value="-0.0101992948"/>

      <xacro:controlled_joint name="right_hand_Thumb_Flexion" initial_value="0.0"/>
      <xacro:controlled_joint name="right_hand_Thumb_Opposition" initial_value="0.0"/>
      <xacro:controlled_joint name="right_hand_Index_Finger_Distal" initial_value="0.0"/>
      <xacro:controlled_joint name="right_hand_Index_Finger_Proximal" initial_value="0.0"/>
      <xacro:controlled_joint name="right_hand_Middle_Finger_Proximal" initial_value="0.0"/>
      <xacro:controlled_joint name="right_hand_Middle_Finger_Distal" initial_value="0.0"/>
      <xacro:controlled_joint name="right_hand_Ring_Finger" initial_value="0.0"/>
      <xacro:controlled_joint name="right_hand_Pinky" initial_value="0.0"/>
      <xacro:controlled_joint name="right_hand_index_spread" initial_value="0.28833"/>
      <xacro:controlled_joint name="right_hand_ring_spread" initial_value="0.28833"/>
      <xacro:controlled_joint name="right_hand_Finger_Spread" initial_value="0.5829"/>
    </ros2_control>
  </xacro:macro>
</robot>
